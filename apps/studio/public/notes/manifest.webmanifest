{
  "id": "/notes/",
  "name": "BCR 笔记",
  "short_name": "笔记",
  "lang": "zh-CN",
  "start_url": "/notes/knowledge/",
  "scope": "/notes/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#151619",
  "theme_color": "#147a73",
  "description": "随时记录想法、收藏链接，离线编辑与同步笔记",
  "share_target": {
    "action": "/notes/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "新建笔记",
      "url": "/notes/knowledge/?action=new"
    }
  ],
  "icons": [
    {
      "src": "/icons/knowledge-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/knowledge-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
