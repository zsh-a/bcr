{
  "id": "/reader",
  "name": "BCR Reader",
  "short_name": "Reader",
  "lang": "zh-CN",
  "start_url": "/pwa/reader/",
  "scope": "/pwa/reader/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#151619",
  "theme_color": "#147a73",
  "description": "离线阅读 EPUB、PDF 与 TXT，保存阅读进度和书签",
  "share_target": {
    "action": "/pwa/reader/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/epub+zip",
            "application/pdf",
            "text/plain",
            ".epub",
            ".pdf",
            ".txt"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "打开书库",
      "url": "/pwa/reader/?action=library"
    }
  ],
  "icons": [
    {
      "src": "/icons/reader-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/reader-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
