{
  "name": "bcr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "bridge": "bun apps/agent-bridge/src/cli.ts",
    "build:wasm": "wasm-pack build crates/kernels --target web && bun run build:wasm:quant && bun run build:wasm:agent",
    "build:wasm:agent": "wasm-pack build crates/agent-runtime/crates/agent-wasm --target web --out-dir ../../../agent-wasm/pkg",
    "check": "vp check && bun run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/agent-bridge/tsconfig.json --noEmit && tsc -p apps/work-runner/tsconfig.json --noEmit",
    "test": "vp test run",
    "test:ci": "node --test scripts/tests/browser-suites.test.mjs",
    "test:browser": "node scripts/verify-ci.mjs",
    "test:browser:full": "node scripts/verify-ci.mjs --suite=full",
    "test:browser:layout": "node scripts/verify-app-layout.mjs",
    "test:browser:ui": "node scripts/verify-modern-ui.mjs",
    "test:browser:resources": "node scripts/verify-resource-layout.mjs",
    "test:browser:knowledge:attachments": "node scripts/verify-knowledge-attachments.mjs",
    "test:browser:knowledge:editor": "node scripts/verify-knowledge-editor-context.mjs",
    "test:browser:reader:menu": "node scripts/verify-reader-context-menu.mjs",
    "test:browser:reader:toolbar": "node scripts/verify-reader-toolbar.mjs",
    "test:browser:diagram": "node scripts/verify-diagram.mjs",
    "test:browser:navigation": "node scripts/verify-workspace-navigation.mjs",
    "test:pwa": "node scripts/verify-reader-pwa.mjs",
    "test:pwa:knowledge": "node scripts/verify-knowledge-pwa.mjs",
    "demo": "cd examples/demo && vp dev",
    "dev": "cd apps/studio && vp dev",
    "studio": "cd apps/studio && vp dev",
    "media": "cd apps/media-studio && vp dev",
    "quant": "cd apps/quant-lab && vp dev",
    "markets": "cd apps/market-board && vp dev",
    "manga": "cd apps/manga-studio && vp dev",
    "docgen": "cd apps/docgen-studio && vp dev",
    "build:cloudflare": "bun run build:wasm && vp -C apps/studio build",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "bench:search": "node scripts/benchmark-search.mjs",
    "test:pwa:android": "node scripts/verify-android-pwa.mjs",
    "test:pwa:apps": "bun scripts/verify-pwa-apps.mjs",
    "generate:pwa": "bun scripts/generate-pwa-entries.mjs && node scripts/generate-pwa-icons.mjs",
    "build:wasm:quant": "wasm-pack build crates/quant --target web",
    "test:rust:quant": "cargo test --manifest-path crates/quant/Cargo.toml",
    "research:trend": "python3 scripts/trend/cli.py",
    "research:trend:test": "python3 -m unittest discover -s scripts/trend -p 'test_*.py'",
    "test:browser:quant:experiments": "node scripts/verify-quant-experiments.mjs",
    "test:browser:quant:charts": "node scripts/verify-quant-chart-events.mjs",
    "test:browser:quant:trend": "node scripts/verify-binance-trend.mjs",
    "test:browser:quant:trend-review": "node scripts/verify-binance-trend-review.mjs",
    "test:browser:quant:kdj": "node scripts/verify-binance-kdj.mjs",
    "test:browser:quant:price-action": "node scripts/verify-binance-price-action.mjs",
    "test:browser:quant:structured-pullback": "node scripts/verify-binance-structured-pullback.mjs",
    "test:browser:quant:walk-forward": "node scripts/verify-quant-walk-forward.mjs",
    "test:browser:jsg": "node scripts/verify-jsg.mjs",
    "test:browser:jsg:grid": "node scripts/verify-jsg-grid.mjs",
    "test:browser:jsg:evaluation": "node scripts/verify-jsg-evaluation.mjs",
    "test:browser:jsg:features": "node scripts/verify-jsg-features.mjs",
    "test:browser:jsg:research": "node scripts/verify-jsg-research.mjs",
    "test:browser:jsg:layout": "node scripts/verify-jsg-layout.mjs",
    "test:browser:jsg:storage": "node scripts/verify-jsg-storage.mjs",
    "test:browser:jsg:fixture": "node scripts/verify-jsg-clickhouse-fixture.mjs",
    "test:browser:jsg:clickhouse": "node scripts/verify-jsg-clickhouse.mjs",
    "runner": "bun apps/work-runner/src/cli.ts",
    "test:runner": "bun test apps/work-runner/tests",
    "test:browser:runner": "bun scripts/verify-work-runner.mjs",
    "build:runner": "bun apps/work-runner/build.ts",
    "test:runner:release": "bun apps/work-runner/tests/release.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "typescript": "^5.9.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.0",
    "wrangler": "4.128.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "effect": "^3.22.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.37.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "pdfjs-dist": "5.4.296",
    "@zip.js/zip.js": "2.9.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@huggingface/transformers": "^3.7.5",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
