{
  "name": "bcr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/kernels --target web",
    "build:wasm:agent": "wasm-pack build crates/agent-runtime/crates/agent-wasm --target web --out-dir ../../../agent-wasm/pkg",
    "check": "vp check && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "test:browser": "node scripts/verify-ci.mjs",
    "test:pwa": "node scripts/verify-reader-pwa.mjs",
    "demo": "cd examples/demo && vp dev",
    "dev": "cd apps/studio && vp dev",
    "studio": "cd apps/studio && vp dev",
    "media": "cd apps/media-studio && vp dev",
    "quant": "cd apps/quant-lab && vp dev",
    "markets": "cd apps/market-board && vp dev",
    "manga": "cd apps/manga-studio && vp dev",
    "docgen": "cd apps/docgen-studio && vp dev",
    "build:cloudflare": "bun run build:wasm && VITE_BCR_CLOUDFLARE=1 vp -C apps/studio build",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "bench:search": "node scripts/benchmark-search.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1"
  },
  "devDependencies": {
    "playwright": "1.61.0",
    "typescript": "^5.9.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.0",
    "wrangler": "4.128.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "effect": "^3.22.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.37.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "pdfjs-dist": "5.4.296",
    "@zip.js/zip.js": "2.9.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@huggingface/transformers": "^3.7.5",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
