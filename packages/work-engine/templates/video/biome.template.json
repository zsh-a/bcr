{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "useSingleVarDeclarator": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "src/**",
      "content.json",
      "data.json",
      "sources.json",
      "voice.json",
      "work.json",
      "production.json",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  }
}
